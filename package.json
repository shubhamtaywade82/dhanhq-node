{
  "name": "algo-scalper-node-sidecar",
  "version": "0.4.1",
  "description": "Node.js Execution Sidecar for DhanHQ v2 using @nemesis-oss/dhanhq-sdk",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "start:headless": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn src/index.ts",
    "dev:server": "ts-node-dev --respawn src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:all": "npm run dev:server & npm run dev:frontend",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@nemesis-oss/dhanhq-sdk": "^1.1.0",
    "@nemesis-oss/ollama-sdk": "^1.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "forceExit": true,
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ]
  }
}
