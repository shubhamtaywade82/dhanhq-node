# DhanHQ Sandbox Trading Mode Configuration
TRADING_MODE=sandbox

# DhanHQ Sandbox Credentials (Order routing only; Market data uses Core .env)
DHAN_SANDBOX_CLIENT_ID=your_sandbox_client_id
DHAN_SANDBOX_ACCESS_TOKEN=your_sandbox_access_token
DHAN_SANDBOX_BASE_URL=https://sandbox.dhan.co/v2

# Risk Engine Limits for Sandbox Mode
RISK_DAILY_MAX_LOSS=50000
RISK_MAX_QUANTITY=500
AUTONOMOUS_SCAN_ENABLED=true
