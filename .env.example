# DhanHQ API Credentials
DHAN_CLIENT_ID=your_client_id
# Optional when using the auth provider below
DHAN_ACCESS_TOKEN=
DHAN_AUTH_PROVIDER_URL=http://localhost:3001
DHAN_AUTH_PROVIDER_TOKEN=api_operator_token

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Trading Mode
TRADING_MODE=paper

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Server
PORT=3003
