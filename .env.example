# DhanHQ API Credentials
DHAN_CLIENT_ID=your_client_id
DHAN_PIN=your_pin
DHAN_TOTP_SECRET=your_base32_totp_secret
DHANHQ_BASE_URL=https://api.dhan.co/v2
DHAN_AUTH_BASE_URL=https://auth.dhan.co

# Direct Access Token (Optional fallback)
DHAN_ACCESS_TOKEN=

# External Auth Authority (Rails API Token Endpoint)
DHAN_AUTH_PROVIDER_URL=http://localhost:3000
DHAN_AUTH_PROVIDER_TOKEN=api_operator_token

# Trading Mode
TRADING_MODE=paper

# Ollama LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Redis & Pub/Sub
REDIS_URL=redis://127.0.0.1:6379/0

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/dhanhq_node_development

# Server Port
PORT=3003
